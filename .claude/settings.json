{
  "permissions": {
    "allow": [
      "Bash(symfony console debug:*)",
      "Bash(symfony console router:match:*)",
      "Bash(symfony console lint:*)",
      "Bash(symfony console oro:debug:*)",
      "Bash(symfony console oro:api:debug:*)",
      "Bash(symfony console oro:message-queue:topics:*)",
      "Bash(symfony console oro:entity-config:debug:*)",
      "Bash(docker compose ps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Edit(vendor/**)",
      "Write(vendor/**)",
      "Bash(rm -rf:*)",
      "Bash(symfony console oro:install:*)",
      "Bash(docker compose down -v:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.sh"
          }
        ]
      }
    ]
  }
}
